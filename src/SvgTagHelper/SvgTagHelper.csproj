<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net60;net80</TargetFrameworks>
    <RootNamespace>Citizen17.SvgTagHelper</RootNamespace>
    <AssemblyName>Citizen17.SvgTagHelper</AssemblyName>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Mikhail Kislenko</Authors>
    <Company />
    <Product>SvgTagHelper</Product>
    <Description>Tag helper for loading SVG content into HTML</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>svg tag helper taghelper</PackageTags>
    <Version>2.0.0</Version>
    <RepositoryUrl>https://github.com/Vampire2008/SvgTagHelpers</RepositoryUrl>
    <RepositoryType></RepositoryType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageReleaseNotes>v2.0.0:
 * Updated target framework to .NET 6 and .NET 8</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
