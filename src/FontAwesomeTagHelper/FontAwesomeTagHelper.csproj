<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net60;net80</TargetFrameworks>
    <AssemblyName>Citizen17.FontAwesomeTagHelper</AssemblyName>
    <RootNamespace>Citizen17.FontAwesomeTagHelper</RootNamespace>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Mikhail Kislenko</Authors>
    <Company />
    <Product>FontAwesomeTagHelper</Product>
    <Description>Tag helper for loading Font Awesome SVG</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Version>2.0.0</Version>
    <PackageProjectUrl>https://github.com/Vampire2008/SvgTagHelpers</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Vampire2008/SvgTagHelpers</RepositoryUrl>
    <RepositoryType>GITHUB</RepositoryType>
    <PackageTags>svg tag helper taghelper fontawesome</PackageTags>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageReleaseNotes>v2.0.0:
 * Updated target framework to .NET 6 and .NET 8</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SvgTagHelper\SvgTagHelper.csproj" />
  </ItemGroup>

</Project>
